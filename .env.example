# Copy this file to .env and fill in your values.

# --- Required ---
DISCORD_TOKEN=your-bot-token
GUILD_ID=123456789012345678
RECAP_CHANNEL=123456789012345678
OWNER_ID=123456789012345678
MONGO_URI=mongodb+srv://user:pass@cluster.example.mongodb.net
GOOGLE_CREDENTIALS_FILE=service-account.json
SPREADSHEET_ID=your-google-sheet-id

# --- Optional (defaults shown) ---
#SHEET_NAME=TOKEN PICKS
#DB_NAME=runaanslocks
#SHEET_DATA_START_ROW=12

# Background sheet sync interval in minutes (0 disables)
#AUTO_SYNC_MINUTES=15

# Post the recap automatically every day (1 = on)
#AUTO_RECAP_ENABLED=0
# Time of the automatic recap, 24h Eastern
#AUTO_RECAP_TIME=23:00
